{
  "lexicon": 1,
  "id": "place.stream.access.defs",
  "defs": {
    "grant": {
      "type": "object",
      "description": "An exact node-local capability entry. Configuration entries cannot be revoked through this API.",
      "required": [
        "id",
        "authority",
        "subject",
        "capability",
        "effect",
        "reason",
        "source",
        "effectiveAllowed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "authority": {
          "type": "string",
          "format": "did"
        },
        "subject": {
          "type": "string",
          "format": "did"
        },
        "capability": {
          "type": "string",
          "enum": ["admin", "viewer", "chat", "streamer", "syndicate", "vod"]
        },
        "effect": {
          "type": "string",
          "enum": ["allow", "deny"]
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "knownValues": ["configuration", "stored"]
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "expiresAt": {
          "type": "string",
          "format": "datetime"
        },
        "effectiveAllowed": {
          "type": "boolean",
          "description": "The subject\u2019s current effective decision, which may be denied by another entry."
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["capability", "mode", "allowed", "reason", "enforced"],
      "properties": {
        "capability": {
          "type": "string",
          "enum": ["admin", "viewer", "chat", "streamer", "syndicate", "vod"]
        },
        "mode": {
          "type": "string",
          "enum": ["open", "allowlist", "off"]
        },
        "defaultMode": {
          "type": "string",
          "enum": ["open", "allowlist", "off"],
          "description": "The startup default restored when a saved mode is removed."
        },
        "modeSource": {
          "type": "string",
          "knownValues": ["configuration", "stored"],
          "description": "Whether this mode comes from startup configuration or saved node policy."
        },
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "enforced": {
          "type": "boolean",
          "description": "Whether this node implements this capability gate. Informational defaults do not imply restricted viewing support."
        }
      }
    }
  }
}
