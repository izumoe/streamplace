+import { Time } from "@moq/net";
+/** A timestamp-indexed PCM reader owned by the audio worklet. */
+export interface MixInput {
+    readonly rate: number;
+    readonly channels: number;
+    readonly mediaTimestamp: Time.Micro;
+    availableAt(timestamp: Time.Micro): number;
+    readAt(output: Float32Array[], timestamp: Time.Micro): number;
+    peekAt(output: Float32Array[], timestamp: Time.Micro): number;
+    advance(timestamp: Time.Micro, revision?: number): boolean;
+    readonly revision: number;
+    read(output: Float32Array[]): number;
+}
+/** Mixes additive inputs at one media cursor, with the full mix as an exclusive alternative. */
+export declare class MixBuffer {
+    #private;
+    readonly inputs: Map<string, MixInput>;
+    /** Requested stem gains; undefined selects the complete main mix. */
+    set levels(value: Record<string, number> | undefined);
+    get levels(): Record<string, number> | undefined;
+    mode: "main" | "loading" | "stems";
+    timestamp: Time.Micro;
+    read(output: Float32Array[]): number;
+    /** Read an aligned window without retiring samples staged by the time stretch. */
+    peek(output: Float32Array[], timestamp: Time.Micro): number;
+    /** Retire only media the shared output playhead has passed. */
+    advance(timestamp: Time.Micro, revisions: ReadonlyMap<string, {
+        revision: number;
+    }>, used: ReadonlySet<string>): boolean;
+    /** Discard an obsolete prefix without reporting audio that has not played. */
+    retire(timestamp: Time.Micro, revisions: ReadonlyMap<string, {
+        revision: number;
+    }>, used: ReadonlySet<string>): boolean;
+    /** Inputs represented in the current audible mix, excluding muted gains. */
+    audible(id: string): boolean;
+    get head(): Time.Micro;
+    /** Available aligned PCM, excluding optional silent inputs. */
+    available(timestamp: Time.Micro): number;
+    get effectiveLevels(): Record<string, number> | undefined;
+    remove(name: string): void;
+}
+//# sourceMappingURL=mix-buffer.d.ts.map
