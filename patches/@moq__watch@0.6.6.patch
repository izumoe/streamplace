+import { Time } from "@moq/net";
+/** A timestamp-indexed PCM reader owned by the audio worklet. */
+export interface MixInput {
+    readonly rate: number;
+    readonly channels: number;
+    readonly mediaTimestamp: Time.Micro;
+    availableAt(timestamp: Time.Micro): number;
+    readAt(output: Float32Array[], timestamp: Time.Micro): number;
+    read(output: Float32Array[]): number;
+}
+/** Mixes additive inputs at one media cursor, with the full mix as an exclusive alternative. */
+export declare class MixBuffer {
+    #private;
+    readonly inputs: Map<string, MixInput>;
+    /** Requested stem gains; undefined selects the complete main mix. */
+    set levels(value: Record<string, number> | undefined);
+    get levels(): Record<string, number> | undefined;
+    mode: "main" | "loading" | "stems";
+    timestamp: Time.Micro;
+    read(output: Float32Array[]): number;
+    get effectiveLevels(): Record<string, number> | undefined;
+    remove(name: string): void;
+    reset(): void;
+}
+//# sourceMappingURL=mix-buffer.d.ts.map
