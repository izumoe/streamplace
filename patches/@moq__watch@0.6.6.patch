+import type * as Moq from "@moq/net";
+import { Time } from "@moq/net";
+import { type Getter, type Inputs, Signal } from "@moq/signals";
+import { Broadcast } from "../broadcast";
+import type { Sync } from "../sync";
+import { Decoder } from "./decoder";
+import { Source } from "./source";
+/** A separately published additive audio group. */
+export type Stem = {
+    alternateGroup: number;
+    name: Moq.Path.Valid;
+    label?: string;
+};
+/** Per-group gain; undefined selects the complete main mix. */
+export type Mix = Record<number, number>;
+/** Download policy and requested additive mix. */
+export type MixerInput = {
+    enabled: Getter<boolean>;
+    stems: Getter<Stem[] | undefined>;
+    mix: Getter<Mix | undefined>;
+};
+/** Constructor properties for synchronized audio mixing. */
+export type MixerProps = Inputs<MixerInput> & {
+    source: Source;
+    broadcast: Broadcast;
+    sync: Sync;
+};
+/** Owns one audio context and render cursor for the main mix and optional additive stems. */
+export declare class Mixer {
+    #private;
+    readonly in: Moq.Signals.Readonlys<{
+        enabled: Getter<boolean>;
+        stems: Getter<Stem[] | undefined>;
+        mix: Getter<Mix | undefined>;
+    }>;
+    readonly main: Decoder;
+    readonly out: Moq.Signals.Readonlys<{
+        mode: Signal<"loading" | "main" | "stems">;
+        reason: Signal<"buffering" | "unavailable" | "unsupported" | undefined>;
+        timestamp: Signal<Time.Milli | undefined>;
+        stalled: Signal<boolean>;
+        stats: Signal<{
+            bytesReceived: number;
+        } | undefined>;
+        bitrate: Signal<number>;
+        levels: Signal<Mix | undefined>;
+    }>;
+    constructor(props: MixerProps);
+    /** Re-anchor every input at a content boundary. */
+    reset(): void;
+    /** Stop audio subscriptions and release the shared renderer. */
+    close(): void;
+}
+//# sourceMappingURL=mixer.d.ts.map
