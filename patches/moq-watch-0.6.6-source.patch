+	// Leave coded work in the bounded consumer until the codec can accept more.
+	async #waitForDecoder(effect: Effect, decoder: VideoDecoder): Promise<boolean> {
+		while (decoder.decodeQueueSize > 0) {
+			if (effect.abort.aborted || decoder.state !== "configured") return false;
+			const dequeued = new Promise<boolean>((resolve) => {
+				const ready = () => resolve(true);
+				effect.event(decoder, "dequeue", ready, { once: true });
+				// A codec can accept work between the first check and listener registration.
+				if (decoder.decodeQueueSize === 0 || decoder.state !== "configured") {
+					decoder.removeEventListener("dequeue", ready);
+					resolve(true);
+				}
+			});
+			if (!(await effect.race(dequeued))) return false;
+		}
+		return !effect.abort.aborted && decoder.state === "configured";
+	}
