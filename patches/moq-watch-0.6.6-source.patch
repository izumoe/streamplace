+			expect(source.out.track.peek()).toBe("low");
+			probe.set({ estimatedRecvRate: 4_000_000 });
+			await settle();
+			expect(source.out.track.peek()).toBe("high");
+		} finally {
+			source.close();
+		}
+	});
+});
