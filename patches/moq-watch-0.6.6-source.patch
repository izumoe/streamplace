+describe("Source bitrate selection", () => {
+	it("keeps resolution preference when a probe arrives without rendition bitrates", async () => {
+		const probe = new Signal<{ estimatedRecvRate: number } | undefined>(undefined);
+		const target = new Signal<Target | undefined>(undefined);
+		const source = new Source({
+			broadcast: mockBroadcast({
+				low: config("avc1.64001e", { codedWidth: 426, codedHeight: 240 }),
+				high: config("av01.0.04M.08", { codedWidth: 1280, codedHeight: 720 }),
+				mid: config("avc1.640028", { codedWidth: 854, codedHeight: 480 }),
+			}),
+			probe,
+			target,
+			supported: async () => true,
+		});
+		try {
+			await settle();
+			expect(source.out.track.peek()).toBe("high");
+			probe.set({ estimatedRecvRate: 5_000_000 });
+			await settle();
+			expect(source.out.track.peek()).toBe("high");
+			target.set({ name: "low" });
+			await settle();
+			expect(source.out.track.peek()).toBe("low");
+			target.set(undefined);
+			await settle();
+			expect(source.out.track.peek()).toBe("high");
+		} finally {
+			source.close();
+		}
+	});
+
