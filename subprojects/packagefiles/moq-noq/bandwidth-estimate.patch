+#[test]
+fn bandwidth_estimate_reaches_path_statistics() -> TestResult {
+    let _guard = subscribe();
+    let mut transport = TransportConfig::default();
+    transport.congestion_controller_factory(Arc::new(Bbr3Config::default()));
+    let mut pair = ConnPair::builder()
+        .with_transport_cfg(transport)
+        .with_latency(Duration::from_millis(10))
+        .connect();
+    let initial = pair
+        .conn_mut(Client)
+        .path_stats(PathId::ZERO)
+        .unwrap()
+        .estimated_bandwidth;
+    assert_eq!(
+        initial,
+        pair.conn(Client)
+            .congestion_state(PathId::ZERO)
+            .unwrap()
+            .estimated_bandwidth()
+    );
+    info!(?initial, "post-handshake bandwidth estimate");
+    upload(&mut pair, 100_000)?;
+    let model = pair
+        .conn(Client)
+        .congestion_state(PathId::ZERO)
+        .unwrap()
+        .estimated_bandwidth();
+    assert!(model.is_some());
+    assert_eq!(
+        pair.conn_mut(Client)
+            .path_stats(PathId::ZERO)
+            .unwrap()
+            .estimated_bandwidth,
+        model
+    );
+    Ok(())
+}
