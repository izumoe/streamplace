+    fn bandwidth_estimate_uses_delivery_model_without_pacing_gain() {
+        const BW: f64 = 1_250_000.0;
+        let mut sim = Sim::new(Bbr3Config::default(), 1200, BW, 100_000_000);
+        assert_eq!(Controller::estimated_bandwidth(&sim.bbr), None);
+        sim.run(
+            1_000_000,
+            |_| ControlFlow::Continue(()),
+            |bbr, now, _, _| {
+                if now >= 5_000_000_000 && matches!(bbr.state, BbrState::ProbeBw(_)) {
+                    ControlFlow::Break(())
+                } else {
+                    ControlFlow::Continue(())
+                }
+            },
+        );
+        let estimate = Controller::estimated_bandwidth(&sim.bbr).unwrap();
+        assert!((estimate as f64 - BW).abs() / BW < 0.05);
+        assert_eq!(estimate, sim.bbr.bw.round() as u64);
+        assert_ne!(Some(estimate), sim.bbr.metrics().pacing_rate);
+        let cwnd_rate = sim.bbr.window() as f64 / sim.bbr.min_rtt.as_secs_f64();
+        assert!(cwnd_rate > estimate as f64 * 1.5);
+    }
