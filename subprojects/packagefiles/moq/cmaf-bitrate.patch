+				high_bytes += padded.len();
+				next.write(padded).unwrap();
+			}
+			next.finish().unwrap();
+			let mut lower = track.append_group().unwrap();
+			lower.write(at_frame(20, 0)).unwrap();
+			assert_eq!(
+				catalog.snapshot().audio.renditions["track"].bitrate,
+				Some(high_bytes as u64 * 8)
+			);
+			for frame in 21..30 {
+				lower.write(at_frame(frame, 0)).unwrap();
+			}
+			lower.finish().unwrap();
+			track.append_group().unwrap().write(at_frame(30, 0)).unwrap();
+			assert_eq!(
+				catalog.snapshot().audio.renditions["track"].bitrate,
+				Some(high_bytes as u64 * 8),
+				"the catalog is a conservative peak, not current throughput"
+			);
+		}
