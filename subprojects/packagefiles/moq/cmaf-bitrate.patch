+	#[test]
+	fn bitrate_measures_media_time_and_preserves_container() {
+		for reordered in [false, true] {
+			let (_broadcast, catalog, mut track) = publish(OPUS_INIT);
+			let mut group = track.append_group().unwrap();
+			let mut bytes = 0;
+			for frame in 0..10 {
+				let fragment = at_frame(frame, if reordered && frame % 2 == 0 { -2_400 } else { 0 });
+				bytes += fragment.len();
+				group.write(fragment).unwrap();
+			}
+			group.finish().unwrap();
+			// A partial window remains unknown, rather than claiming zero or timing this burst.
+			assert_eq!(catalog.snapshot().audio.renditions["track"].bitrate, None);
+			let mut next = track.append_group().unwrap();
+			next.write(at_frame(10, 0)).unwrap();
+			let config = catalog.snapshot().audio.renditions["track"].clone();
+			assert_eq!(config.bitrate, Some(bytes as u64 * 8));
+			assert_eq!(config.container, Container::Cmaf { init: OPUS_INIT.into() });
+			assert_eq!(config.jitter, None, "import arrival time is not encoder jitter");
+			let mut high_bytes = at_frame(10, 0).len();
