+#[cfg(test)]
+mod cache_tests {
+	use super::*;
+	use moq_net::time::Driver;
+	use std::time::{Duration, Instant};
+
+	#[tokio::test]
+	async fn standalone_cache_expires_history_and_drains_after_close() {
+		let broadcast = moq_net::broadcast::Info::new().produce();
+		let pool = broadcast.info().pool.clone();
+		let mut driver = BroadcastCache {
+			pool: pool.clone(),
+			closed: broadcast.consume(),
+		};
+		let track = broadcast
+			.create_track("video", moq_net::track::Info::default())
+			.unwrap();
+		let mut old = track.append_group().unwrap();
+		old.write_frame(moq_net::Timestamp::ZERO, vec![1; 4096]).unwrap();
+		old.finish().unwrap();
+		let mut stale = old.consume();
+		let mut latest = track.append_group().unwrap();
+		latest.write_frame(moq_net::Timestamp::ZERO, vec![2; 4096]).unwrap();
+		latest.finish().unwrap();
+		let mut current = latest.consume();
+		let used = pool.used();
+		let now = Instant::now();
+		let waiter = kio::Waiter::noop();
+		assert!(driver.poll(now, &waiter).unwrap().is_some());
+		let later = now + moq_net::cache::DEFAULT_EXPIRY + Duration::from_secs(1);
+		driver.poll(later, &waiter).unwrap();
+		assert!(pool.used() < used, "unread historical frames must be released");
+		assert!(matches!(stale.next_frame().await, Err(moq_net::Error::Old)));
+		assert_eq!(current.next_frame().await.unwrap().unwrap().size, 4096);
+		track.finish().unwrap();
+		drop(track);
+		broadcast.close();
+		assert!(driver.poll(later + Duration::from_secs(1), &waiter).is_ok());
+		// Access is dated by the next collection pass, then gets the full idle window.
+		assert!(driver.poll(later + moq_net::cache::DEFAULT_EXPIRY, &waiter).is_ok());
+		assert!(matches!(
+			driver.poll(later + moq_net::cache::DEFAULT_EXPIRY * 3, &waiter),
+			Err(moq_net::Error::Closed)
+		));
+		assert_eq!(pool.used(), 0, "a stale consumer must not pin finished media");
+	}
+
+	#[test]
+	fn standalone_cache_stops_without_owning_the_publisher() {
+		for close in [false, true] {
+			let broadcast = moq_net::broadcast::Info::new().produce();
+			let mut driver = BroadcastCache {
+				pool: broadcast.info().pool.clone(),
+				closed: broadcast.consume(),
+			};
+			let now = Instant::now();
+			let waiter = kio::Waiter::noop();
+			assert!(driver.poll(now, &waiter).is_ok());
+			if close {
+				broadcast.close();
+			}
+			drop(broadcast);
+			assert!(matches!(driver.poll(now, &waiter), Err(moq_net::Error::Closed)));
+		}
+	}
+}
