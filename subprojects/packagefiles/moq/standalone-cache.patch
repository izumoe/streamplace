+// Standalone broadcasts have no origin driver to advance their cache clock.
+// Keep collecting after close until finished tracks' stale consumers release
+// their cached frames, without keeping any publisher alive.
+struct BroadcastCache {
+	pool: moq_net::cache::Pool,
+	closed: moq_net::broadcast::Consumer,
+}
+
+impl moq_net::time::Driver for BroadcastCache {
+	fn poll(
+		&mut self,
+		now: moq_net::time::Instant,
+		waiter: &kio::Waiter,
+	) -> Result<Option<moq_net::time::Instant>, moq_net::Error> {
+		let next = self.pool.gc(now);
+		if self.closed.poll_closed(waiter).is_ready() && self.pool.used() == 0 {
+			return Err(moq_net::Error::Closed);
+		}
+		Ok(next)
+	}
+}
