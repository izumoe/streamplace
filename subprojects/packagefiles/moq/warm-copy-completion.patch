+	/// Finishing the source after the cached-frame drain must not seal a shorter snapshot.
+	#[test]
+	fn warm_rebuild_keeps_a_racing_source_finish_open() {
+		struct FinishSource(std::sync::Mutex<Option<group::Producer>>);
+
+		impl std::task::Wake for FinishSource {
+			fn wake(self: Arc<Self>) {
+				self.wake_by_ref();
+			}
+
+			fn wake_by_ref(self: &Arc<Self>) {
+				if let Some(mut source) = self.0.lock().unwrap().take() {
+					source.write_frame(crate::Timestamp::ZERO, b"tail".as_ref()).unwrap();
+					source.finish().unwrap();
+				}
+			}
+		}
+
+		let info = Arc::new(broadcast::Info::default());
+		let source_track = track::Producer::new(info.clone(), "video", None);
+		let mut source = source_track.create_group(0u64.into()).unwrap();
+		source.write_frame(crate::Timestamp::ZERO, b"head".as_ref()).unwrap();
+		let rebuilt_track = track::Producer::new(info, "video", None);
+		let consumer = rebuilt_track.consume();
+		let waiter = kio::Waiter::new(std::task::Waker::from(Arc::new(FinishSource(std::sync::Mutex::new(
+			Some(source.clone()),
+		)))));
+		// Creating the rebuilt group wakes this consumer after the source drain,
+		// deterministically delivering the final source frame before the rebuild returns.
+		assert!(consumer.poll_peek_group(0, &waiter).is_pending());
+		let rebuilt = warm_rebuild(&rebuilt_track, &source, None).unwrap();
+		assert!(source.is_finished(), "the source completed during the rebuild");
+		assert_eq!(source.frame_count(), 2);
+		let mut reading = rebuilt.0.consume();
+		assert_eq!(
+			&reading.read_frame().now_or_never().unwrap().unwrap().unwrap().payload[..],
+			b"head"
+		);
+		assert!(
+			reading.read_frame().now_or_never().is_none(),
+			"the cached head must wait for the uncopied tail rather than report a clean end"
+		);
+	}
+
